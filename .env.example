# cxo_scanner environment. NAMES ONLY: real values live in Vercel (project behind audit.cxo.studio).
# Get them with access to the Vercel project:  vercel link && vercel env pull .env.local
# Never commit .env.local, never paste keys in chat or tickets.

# --- Required to run a scan ---------------------------------------------------
SUPABASE_URL=                      # Supabase project URL (scan jobs, leads, bookings, report images)
SUPABASE_SERVICE_ROLE_KEY=         # server-only key, full access: treat as a password
API_URL=                           # Airtable "Conversion Checkpoints" table URL (base app1HP8C17pAMjacf)
API_KEY=                           # Airtable personal access token, read (+ write for /lab promote)
OPENROUTER_API_KEY=                # AI judging of checkpoints (all models go through OpenRouter)
PAGESPEED_API_KEY=                 # Google PageSpeed Insights (speed checkpoints)

# --- Models (defaults in code, override only to experiment) -------------------
SCAN_V2_MODEL=                     # main judge, default google/gemini-2.5-flash
SCAN_VERIFY_MODEL=                 # second opinion on fails, default anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=                  # legacy image analysis
OPENROUTER_LOCATE_MODEL=           # pin placement on screenshots
OPENROUTER_VISION_PIN_MODEL=       # vision fallback for pins (full report)
OPENROUTER_SUGGEST_MODEL=          # /lab suggestions
OPENROUTER_REFERER=                # sent to OpenRouter for attribution
OPENROUTER_TITLE=
GEMINI_API_KEY=                    # direct Gemini calls (vision pins, box_2d)
GEMINI_MODEL=

# --- Remote browser (stores that block our own Chrome) ------------------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
CHROME_EXECUTABLE_PATH=            # local dev only: path to your Chrome

# --- Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=                        # "Louis from CXO studio <scan@cxo.studio>"
EMAIL_REPLY_TO=
FEEDBACK_TO=                       # team inbox for alerts, feedback, new bookings

# --- Paid report (Stripe) -----------------------------------------------------
STRIPE_SECRET_KEY=                 # use a TEST key (sk_test_...) anywhere but production
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_FULL_REPORT_PRICE=

# --- Webhooks, cron, admin ----------------------------------------------------
CAL_WEBHOOK_SECRET=                # signs Cal.com booking webhooks (/api/cal/webhook)
CRON_SECRET=                       # Vercel cron auth for /api/followups/run (every 5 min)
LAB_KEY=                           # password for /lab and /admin/leads

# --- Limits and tuning (optional, defaults in code) ---------------------------
SCAN_DAILY_LIMIT=                  # scans per visitor per day, default 5
DOMAIN_DAILY_LIMIT=                # scans per domain per day, default 2
BG_SCANS_PER_IP_HOUR=              # background scans per visitor per hour, default 6
SCAN_AI_CONCURRENCY=               # parallel AI calls, default 5
SCAN_DOUBLE_CHECK=                 # 'off' skips the second-opinion pass
REPORT_UPLOAD_DRAFTS=              # 'off' hides Draft checkpoints from customer uploads
CHECKPOINTS_CACHE_TTL_MS=          # server cache of Airtable checkpoints
CHECKPOINTS_BROWSER_CACHE_SECONDS=
SCAN_ENGINE=                       # 'v2' (default)
NEXT_PUBLIC_SCAN_ENGINE=
NEXT_PUBLIC_SCAN_BATCH_RULES=
NEXT_PUBLIC_CHECKLIST_URL=
SCAN_SELF_URL=                     # local dev: http://localhost:3000/scan
SCAN_GALLERY_OVERVIEW=             # '1' = experimental gallery capture
SCAN_FULL_GALLERY=                 # '1' = experimental gallery capture
SCANV2_NOBLOCK=                    # any value: don't block trackers/media during capture
SCANV2_DEBUG=                      # any value: verbose capture logs
# Vercel sets VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL itself.
