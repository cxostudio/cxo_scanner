{
  "crons": [
    {
      "path": "/scan/api/checkpoints/refresh",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/scan/api/keep-alive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/scan/api/followups/run",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "portal.cxo.studio"
        }
      ],
      "destination": "/scan/api/:path*"
    },
    {
      "source": "/scan/:path*",
      "has": [
        {
          "type": "host",
          "value": "portal.cxo.studio"
        }
      ],
      "destination": "/scan/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portal.cxo.studio"
        }
      ],
      "destination": "/scan/portal/index.html"
    }
  ],
  "regions": [
    "fra1"
  ],
  "fluid": false,
  "functions": {
    "app/api/scan/route.ts": {
      "memory": 3009
    }
  }
}
